        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 50px;
      }

      .hero-metrics-bar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 28px;
        flex-wrap: wrap;
