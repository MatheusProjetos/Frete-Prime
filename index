      .section-padding {
        padding: 90px 0;
      }

      .section-header {
        text-align: center;
        max-width: 760px;
        margin: 0 auto 50px;
      }

      .section-title {
        font-size: clamp(1.8rem, 3.5vw, 2.5rem);
