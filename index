    <!-- NAVEGAÇÃO E CONTROLE DE TELAS IMEDIATO (Garante que botões nunca travem) -->
    <script>
      window.appState = {
        session: null,
        user: null,
        profile: null,
        currentView: 'landing',
        selectedRole: 'empresa',
        conversas: [],
        currentConversaId: null,
        mensagens: []
      };

      // Navegar para a Landing Page (clique na logo ou nome da empresa)
      window.navigateToLanding = function(e) {
        if (e) {
          if (typeof e.preventDefault === 'function') e.preventDefault();
          if (typeof e.stopPropagation === 'function') e.stopPropagation();
        }
        window.switchView('landing');
        try {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } catch(err) {
          window.scrollTo(0, 0);
        }
        return false;
      };

      // Alternar telas da SPA com garantia total de exibição
      window.switchView = function(viewName) {
        window.appState.currentView = viewName;
        
        var allViews = document.querySelectorAll('.spa-view');
        for (var i = 0; i < allViews.length; i++) {
          allViews[i].classList.remove('active');
          allViews[i].style.display = 'none';
        }

        var targetMap = {
          'landing': 'viewLanding',
          'auth': 'viewAuth',
          'empresa-meus-fretes': 'viewEmpresaMeusFretes',
          'empresa-publicar': 'viewEmpresaPublicar',
          'motorista-encontrar': 'viewMotoristaEncontrar',
          'motorista-plano': 'viewMotoristaPlano',
          'chat': 'viewChat',
          'minha-conta': 'viewMinhaConta'
        };

        var targetId = targetMap[viewName] || 'viewLanding';
        var el = document.getElementById(targetId);
        if (el) {
          el.classList.add('active');
          el.style.display = 'block';
        }

        // Visibilidade do botão Home no header
        var btnHome = document.getElementById('btnIrParaLanding');
        if (btnHome) {
          btnHome.style.display = viewName === 'landing' ? 'none' : 'inline-flex';
        }

        // Se for para a landing page e não estiver logado, garante os links de navegação visíveis
        var landingNav = document.getElementById('landingNavLinks');
        if (landingNav && (!window.appState.user)) {
          landingNav.style.display = viewName === 'landing' ? 'flex' : 'none';
        }

        // Carrega dados específicos da tela
        if (typeof carregarMeusFretes === 'function' && viewName === 'empresa-meus-fretes') carregarMeusFretes();
        if (typeof carregarCargasDisponiveis === 'function' && viewName === 'motorista-encontrar') carregarCargasDisponiveis();
        if (typeof carregarConversas === 'function' && viewName === 'chat') carregarConversas();
        if (typeof preencherMinhaConta === 'function' && viewName === 'minha-conta') preencherMinhaConta();

        try {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } catch(err) {
          window.scrollTo(0, 0);
        }
      };

      // Alternar abas ENTRAR / CADASTRAR instantaneamente
      window.switchAuthTab = function(tab) {
        var btnEntrar = document.getElementById('tabBtnEntrar');
        var btnCad = document.getElementById('tabBtnCadastrar');
        var formEntrar = document.getElementById('formEntrar');
        var formCad = document.getElementById('formCadastrar');
        var titleText = document.getElementById('authTitleText');
        var subtitleText = document.getElementById('authSubtitleText');

        if (tab === 'entrar') {
          if (btnEntrar) {
            btnEntrar.classList.add('active');
            btnEntrar.setAttribute('aria-selected', 'true');
          }
          if (btnCad) {
            btnCad.classList.remove('active');
            btnCad.setAttribute('aria-selected', 'false');
          }
          if (formEntrar) {
            formEntrar.style.display = 'block';
          }
          if (formCad) {
            formCad.style.display = 'none';
          }
          if (titleText) titleText.textContent = 'Acesse o Frete Prime';
          if (subtitleText) subtitleText.textContent = 'Conecte-se com fretes rodoviários em todo o país.';
        } else {
          if (btnCad) {
            btnCad.classList.add('active');
            btnCad.setAttribute('aria-selected', 'true');
          }
          if (btnEntrar) {
            btnEntrar.classList.remove('active');
            btnEntrar.setAttribute('aria-selected', 'false');
          }
          if (formCad) {
            formCad.style.display = 'block';
          }
          if (formEntrar) {
            formEntrar.style.display = 'none';
          }
          if (titleText) titleText.textContent = 'Crie sua conta gratuita';
          if (subtitleText) subtitleText.textContent = 'Comece a publicar cargas ou encontrar fretes em minutos.';
        }
      };

      // Abrir tela de autenticação já na aba correta
      window.openAuth = function(tab, role) {
        tab = tab || 'entrar';
        role = role || 'empresa';
        window.switchView('auth');
        window.switchAuthTab(tab);
        if (tab === 'cadastrar' && typeof window.selectRole === 'function') {
          window.selectRole(role);
        }
      };

      // Selecionar perfil Empresa ou Motorista no cadastro
      window.selectRole = function(role) {
        window.appState.selectedRole = role;
        var cardEmpresa = document.getElementById('roleCardEmpresa');
        var cardMotorista = document.getElementById('roleCardMotorista');
        if (cardEmpresa) cardEmpresa.classList.toggle('selected', role === 'empresa');
        if (cardMotorista) cardMotorista.classList.toggle('selected', role === 'motorista');

        var lblNome = document.getElementById('lblCadNome');
        var lblDoc = document.getElementById('lblCadDocumento');
        var inputDoc = document.getElementById('cadDocumento');

        if (lblNome) lblNome.textContent = role === 'empresa' ? 'Razão Social ou Nome Fantasia' : 'Nome Completo do Motorista';
        if (lblDoc) lblDoc.textContent = role === 'empresa' ? 'CNPJ' : 'CPF';
        if (inputDoc) inputDoc.placeholder = role === 'empresa' ? '00.000.000/0001-00' : '000.000.000-00';
      };

      // Abas da Seção de Planos da Landing Page
      window.switchLandingPlanTab = function(type) {
        var btnM = document.getElementById('lpTabMotoristas');
        var btnE = document.getElementById('lpTabEmpresas');
        var boxM = document.getElementById('lpContentMotoristas');
        var boxE = document.getElementById('lpContentEmpresas');

        if (type === 'motoristas') {
          if (btnM) btnM.classList.add('active');
          if (btnE) btnE.classList.remove('active');
          if (boxM) boxM.style.display = 'grid';
          if (boxE) boxE.style.display = 'none';
        } else {
          if (btnE) btnE.classList.add('active');
          if (btnM) btnM.classList.remove('active');
          if (boxE) boxE.style.display = 'grid';
          if (boxM) boxM.style.display = 'none';
        }
      };
    </script>

    <!-- ===================================================================
         SQL COMPLETO PARA CRIAR AS TABELAS NO SUPABASE SQL EDITOR:
         ===================================================================
    /*
    -- 1. TABELA DE PERFIS
    CREATE TABLE IF NOT EXISTS public.profiles (
      id UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
      tipo TEXT NOT NULL CHECK (tipo IN ('empresa', 'motorista')),
      nome TEXT NOT NULL,
      email TEXT NOT NULL,
      whatsapp TEXT,
      documento TEXT,
      verificado BOOLEAN DEFAULT false,
      plano_ativo BOOLEAN DEFAULT false,
      plano_tipo TEXT CHECK (plano_tipo IN ('mensal', 'semestral', 'anual', 'empresa_pro', NULL)),
      plano_vencimento TIMESTAMPTZ,
      contatos_gratuitos_usados INTEGER DEFAULT 0,
      criado_em TIMESTAMPTZ DEFAULT now()
    );

    -- 2. TABELA DE FRETES
    CREATE TABLE IF NOT EXISTS public.fretes (
      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
      empresa_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
      origem_cidade TEXT NOT NULL,
      origem_estado TEXT NOT NULL,
      destino_cidade TEXT NOT NULL,
      destino_estado TEXT NOT NULL,
      tipo_veiculo TEXT NOT NULL CHECK (tipo_veiculo IN ('Truck', 'Carreta', 'Bitrem', 'Van', 'Outros')),
      tipo_carga TEXT NOT NULL,
      peso_kg NUMERIC NOT NULL,
      valor_frete NUMERIC NOT NULL,
      data_coleta DATE NOT NULL,
      descricao TEXT,
      status TEXT NOT NULL DEFAULT 'ativo' CHECK (status IN ('ativo', 'encerrado', 'pausado')),
      criado_em TIMESTAMPTZ DEFAULT now()
    );

    -- 3. TABELA DE CONVERSAS
    CREATE TABLE IF NOT EXISTS public.conversas (
      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
      frete_id UUID NOT NULL REFERENCES public.fretes(id) ON DELETE CASCADE,
      empresa_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
      motorista_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
      criado_em TIMESTAMPTZ DEFAULT now(),
      CONSTRAINT conversa_unica_frete_motorista UNIQUE (frete_id, motorista_id)
    );

    -- 4. TABELA DE MENSAGENS
    CREATE TABLE IF NOT EXISTS public.mensagens (
      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
      conversa_id UUID NOT NULL REFERENCES public.conversas(id) ON DELETE CASCADE,
      remetente_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
      texto TEXT NOT NULL,
      lida BOOLEAN DEFAULT false,
      criado_em TIMESTAMPTZ DEFAULT now()
    );

    -- ATIVAR RLS
    ALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;
    ALTER TABLE public.fretes ENABLE ROW LEVEL SECURITY;
    ALTER TABLE public.conversas ENABLE ROW LEVEL SECURITY;
    ALTER TABLE public.mensagens ENABLE ROW LEVEL SECURITY;

    -- POLÍTICAS RLS
    CREATE POLICY "Perfis autenticados visiveis" ON public.profiles FOR SELECT TO authenticated USING (true);
    CREATE POLICY "Usuario edita proprio perfil" ON public.profiles FOR UPDATE TO authenticated USING (auth.uid() = id);
    CREATE POLICY "Usuario insere proprio perfil" ON public.profiles FOR INSERT TO authenticated WITH CHECK (auth.uid() = id);

    CREATE POLICY "Fretes visiveis" ON public.fretes FOR SELECT TO authenticated USING (status = 'ativo' OR empresa_id = auth.uid());
    CREATE POLICY "Empresa insere fretes" ON public.fretes FOR INSERT TO authenticated WITH CHECK (empresa_id = auth.uid());
    CREATE POLICY "Empresa edita fretes" ON public.fretes FOR UPDATE TO authenticated USING (empresa_id = auth.uid());

    CREATE POLICY "Conversas visiveis aos participantes" ON public.conversas FOR SELECT TO authenticated USING (empresa_id = auth.uid() OR motorista_id = auth.uid());
    CREATE POLICY "Motorista cria conversa" ON public.conversas FOR INSERT TO authenticated WITH CHECK (motorista_id = auth.uid());

    CREATE POLICY "Mensagens visiveis aos participantes" ON public.mensagens FOR SELECT TO authenticated USING (
      EXISTS (SELECT 1 FROM public.conversas c WHERE c.id = conversa_id AND (c.empresa_id = auth.uid() OR c.motorista_id = auth.uid()))
    );
    CREATE POLICY "Participante envia mensagem" ON public.mensagens FOR INSERT TO authenticated WITH CHECK (remetente_id = auth.uid());
    */
    -->

    <style>
      :root {
        --primary: #FF6B00;
        --primary-hover: #E05E00;
        --primary-light: rgba(255, 107, 0, 0.12);
        --primary-glow: rgba(255, 107, 0, 0.35);
        --bg-dark: #0A0A0A;
        --bg-secondary: #141414;
        --bg-tertiary: #1E1E1E;
        --bg-card: #181818;
        --bg-card-hover: #222222;
        --border-subtle: #262626;
        --border-highlight: rgba(255, 107, 0, 0.35);
        --text-main: #FFFFFF;
        --text-muted: #A3A3A3;
        --text-dim: #737373;
        --success: #10B981;
        --danger: #EF4444;
        --font-title: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --radius-sm: 8px;
        --radius-md: 14px;
        --radius-lg: 20px;
        --radius-full: 9999px;
        --transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
        font-size: 16px;
      }

      body {
        font-family: var(--font-body);
        background-color: var(--bg-dark);
        color: var(--text-main);
        line-height: 1.6;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-title);
        font-weight: 700;
        line-height: 1.2;
        color: var(--text-main);
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      p {
        color: var(--text-muted);
      }

      .container {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
      }

      .text-orange { color: var(--primary); }

      /* Botões */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-family: var(--font-title);
        font-size: 0.92rem;
        font-weight: 600;
        padding: 12px 24px;
        border-radius: var(--radius-full);
        border: none;
        cursor: pointer;
        transition: var(--transition);
        white-space: nowrap;
        text-decoration: none;
      }

      .btn-primary {
        background: var(--primary);
        color: #FFFFFF;
        box-shadow: 0 4px 14px var(--primary-glow);
      }
      .btn-primary:hover {
        background: var(--primary-hover);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(255, 107, 0, 0.45);
      }

      .btn-outline {
        background: transparent;
        color: #FFFFFF;
        border: 1.5px solid rgba(255, 255, 255, 0.25);
      }
      .btn-outline:hover {
        border-color: #FFFFFF;
        background: rgba(255, 255, 255, 0.08);
      }

      .btn-sm {
        padding: 8px 16px;
        font-size: 0.84rem;
      }

      .btn-block {
        width: 100%;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        border-radius: var(--radius-full);
        font-size: 0.76rem;
        font-weight: 600;
        text-transform: uppercase;
      }
      .badge-success { background: rgba(16, 185, 129, 0.15); color: #34D399; border: 1px solid rgba(16, 185, 129, 0.3); }
      .badge-warning { background: rgba(245, 158, 11, 0.15); color: #FBBF24; border: 1px solid rgba(245, 158, 11, 0.3); }
      .badge-danger { background: rgba(239, 68, 68, 0.15); color: #F87171; border: 1px solid rgba(239, 68, 68, 0.3); }
      .badge-orange { background: rgba(255, 107, 0, 0.15); color: var(--primary); border: 1px solid rgba(255, 107, 0, 0.3); }

      /* ===================================================================
         HEADER FIXO COM O ÍCONE SOLICITADO NO RODATETO
         =================================================================== */
      .site-header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        background: rgba(10, 10, 10, 0.95);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--border-subtle);
        z-index: 1000;
        padding: 14px 0;
        transition: var(--transition);
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .brand-logo {
        display: flex;
        align-items: center;
        gap: 12px;
        font-family: var(--font-title);
        font-size: 1.45rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        cursor: pointer;
        text-decoration: none;
        color: #FFFFFF;
        user-select: none;
        transition: transform 0.2s ease, opacity 0.2s ease;
      }

      .brand-logo:hover {
        opacity: 0.92;
        transform: translateY(-1px);
        color: #FFFFFF;
      }

      .brand-logo * {
        cursor: pointer;
      }

      .logo-icon-wrap {
        width: 48px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .logo-icon-wrap svg {
        width: 100%;
        height: 100%;
        display: block;
        filter: drop-shadow(0 2px 8px rgba(255, 107, 0, 0.4));
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 20px;
      }

      .nav-item {
        color: var(--text-muted);
        font-size: 0.92rem;
        font-weight: 500;
        cursor: pointer;
        transition: color 0.2s ease;
      }

      .nav-item:hover {
        color: #FFFFFF;
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      /* ===================================================================
         VISTAS DA SPA
         =================================================================== */
      .spa-view {
        display: none;
      }
      .spa-view.active {
        display: block;
      }

      /* ===================================================================
         LANDING PAGE ESTILOS
         =================================================================== */
