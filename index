      // 9. MÁSCARAS DE INPUT
      function setupMasks() {
        const zapInputs = [document.getElementById('cadWhatsapp'), document.getElementById('perfilInputWhatsapp')];
        zapInputs.forEach(el => {
          if (!el) return;
          el.addEventListener('input', () => {
            let v = el.value.replace(/\D/g, '');
            if (v.length > 11) v = v.substring(0, 11);
            if (v.length > 10) el.value = v.replace(/^(\d{2})(\d{5})(\d{4})$/, '($1) $2-$3');
            else if (v.length > 6) el.value = v.replace(/^(\d{2})(\d{4})(\d{0,4})$/, '($1) $2-$3');
            else if (v.length > 2) el.value = v.replace(/^(\d{2})(\d{0,5})$/, '($1) $2');
            else el.value = v;
          });
        });

        const docInput = document.getElementById('cadDocumento');
        if (docInput) {
          docInput.addEventListener('input', () => {
            let v = docInput.value.replace(/\D/g, '');
            if (window.appState.selectedRole === 'empresa') {
              if (v.length > 14) v = v.substring(0, 14);
              v = v.replace(/^(\d{2})(\d)/, '$1.$2');
              v = v.replace(/^(\d{2})\.(\d{3})(\d)/, '$1.$2.$3');
              v = v.replace(/\.(\d{3})(\d)/, '.$1/$2');
              v = v.replace(/(\d{4})(\d)/, '$1-$2');
            } else {
              if (v.length > 11) v = v.substring(0, 11);
              v = v.replace(/(\d{3})(\d)/, '$1.$2');
              v = v.replace(/(\d{3})(\d)/, '$1.$2');
              v = v.replace(/(\d{3})(\d{1,2})$/, '$1-$2');
            }
            docInput.value = v;
          });
        }

        const valInput = document.getElementById('freteValor');
        if (valInput) {
          valInput.addEventListener('input', () => {
            let v = valInput.value.replace(/\D/g, '');
            if (!v) { valInput.value = ''; return; }
            let num = (parseInt(v, 10) / 100).toFixed(2);
            valInput.value = 'R$ ' + Number(num).toLocaleString('pt-BR', { minimumFractionDigits: 2 });
          });
        }
      }

      function showToast(msg, type = 'info') {
        const container = document.getElementById('toastContainer');
        if (!container) return;
        const toast = document.createElement('div');
        toast.className = `toast ${type}`;
        toast.textContent = msg;
        container.appendChild(toast);
        setTimeout(() => toast.remove(), 4000);
      }
    </script>
  </body>
</html>
