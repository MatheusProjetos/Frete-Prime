        min-height: 90vh;
        padding: 150px 0 90px;
        display: flex;
        align-items: center;
        background: radial-gradient(circle at 50% 15%, rgba(255, 107, 0, 0.16) 0%, rgba(10, 10, 10, 0.98) 72%);
