    <!-- ===================================================================
         JAVASCRIPT ROBUSTO (SEM TRAVAMENTOS + NAVEGAÇÃO COMPLETA)
         =================================================================== -->
    <script>
      /**
       * FRETE PRIME - SCRIPT TOTALMENTE PROTEGIDO
       */

      // 1. DECLARAÇÃO GLOBAL IMEDIATA DE FUNÇÕES DE NAVEGAÇÃO E TABS
      window.appState = {
        session: null,
        user: null,
        profile: null,
        currentView: 'landing',
        selectedRole: 'empresa',
        conversas: [],
        currentConversaId: null,
        mensagens: []
      };

      // Navegar para a Landing Page (clique na logo)
      window.navigateToLanding = function() {
        window.switchView('landing');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      };

      // Alternar telas da SPA
      window.switchView = function(viewName) {
        document.querySelectorAll('.spa-view').forEach(v => v.classList.remove('active'));
        
        window.appState.currentView = viewName;
        const targetViewId = {
          'landing': 'viewLanding',
          'auth': 'viewAuth',
          'empresa-meus-fretes': 'viewEmpresaMeusFretes',
          'empresa-publicar': 'viewEmpresaPublicar',
          'motorista-encontrar': 'viewMotoristaEncontrar',
          'motorista-plano': 'viewMotoristaPlano',
          'chat': 'viewChat',
          'minha-conta': 'viewMinhaConta'
        }[viewName] || 'viewLanding';

        const el = document.getElementById(targetViewId);
        if (el) el.classList.add('active');

        // Atualiza visibilidade dos menus no header
        const btnHome = document.getElementById('btnIrParaLanding');
        if (btnHome) btnHome.style.display = viewName === 'landing' ? 'none' : 'inline-flex';

        // Carrega dados específicos da tela
        if (viewName === 'empresa-meus-fretes') carregarMeusFretes();
        if (viewName === 'motorista-encontrar') carregarCargasDisponiveis();
        if (viewName === 'chat') carregarConversas();
        if (viewName === 'minha-conta') preencherMinhaConta();

        window.scrollTo({ top: 0, behavior: 'smooth' });
      };

      // Alternar abas ENTRAR / CADASTRAR (100% GARANTIDO)
      window.switchAuthTab = function(tab) {
        const btnEntrar = document.getElementById('tabBtnEntrar');
        const btnCad = document.getElementById('tabBtnCadastrar');
        const formEntrar = document.getElementById('formEntrar');
        const formCad = document.getElementById('formCadastrar');
        const titleText = document.getElementById('authTitleText');

        if (tab === 'entrar') {
          if (btnEntrar) btnEntrar.classList.add('active');
          if (btnCad) btnCad.classList.remove('active');
          if (formEntrar) formEntrar.style.display = 'block';
          if (formCad) formCad.style.display = 'none';
          if (titleText) titleText.textContent = 'Acesse o Frete Prime';
        } else {
          if (btnCad) btnCad.classList.add('active');
          if (btnEntrar) btnEntrar.classList.remove('active');
          if (formCad) formCad.style.display = 'block';
          if (formEntrar) formEntrar.style.display = 'none';
          if (titleText) titleText.textContent = 'Crie sua conta gratuita';
        }
      };

      // Abrir tela de autenticação já na aba correta
      window.openAuth = function(tab = 'entrar', role = 'empresa') {
        window.switchView('auth');
        window.switchAuthTab(tab);
        if (tab === 'cadastrar') {
          window.selectRole(role);
        }
      };

      // Selecionar perfil Empresa ou Motorista no cadastro
      window.selectRole = function(role) {
        window.appState.selectedRole = role;
        const cardEmpresa = document.getElementById('roleCardEmpresa');
        const cardMotorista = document.getElementById('roleCardMotorista');
        if (cardEmpresa) cardEmpresa.classList.toggle('selected', role === 'empresa');
        if (cardMotorista) cardMotorista.classList.toggle('selected', role === 'motorista');

        const lblNome = document.getElementById('lblCadNome');
        const lblDoc = document.getElementById('lblCadDocumento');
        const inputDoc = document.getElementById('cadDocumento');

        if (lblNome) lblNome.textContent = role === 'empresa' ? 'Razão Social ou Nome Fantasia' : 'Nome Completo do Motorista';
        if (lblDoc) lblDoc.textContent = role === 'empresa' ? 'CNPJ' : 'CPF';
        if (inputDoc) inputDoc.placeholder = role === 'empresa' ? '00.000.000/0001-00' : '000.000.000-00';
      };

      // Abas da Seção de Planos da Landing Page
      window.switchLandingPlanTab = function(type) {
        const btnM = document.getElementById('lpTabMotoristas');
        const btnE = document.getElementById('lpTabEmpresas');
        const boxM = document.getElementById('lpContentMotoristas');
        const boxE = document.getElementById('lpContentEmpresas');

        if (type === 'motoristas') {
          if (btnM) btnM.classList.add('active');
          if (btnE) btnE.classList.remove('active');
          if (boxM) boxM.style.display = 'grid';
