        flex: 1;
        background: transparent;
        border: none;
        color: var(--text-muted);
        padding: 10px;
        border-radius: var(--radius-full);
        font-family: var(--font-title);
        font-weight: 600;
        font-size: 0.92rem;
        cursor: pointer;
        transition: var(--transition);
      }

      .auth-tab-btn.active {
        background: var(--primary);
        color: #FFFFFF;
      }

      .role-picker {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 20px;
      }

      .role-card {
        background: #111;
        border: 2px solid var(--border-subtle);
        border-radius: var(--radius-md);
        padding: 14px;
        text-align: center;
        cursor: pointer;
        transition: var(--transition);
      }

      .role-card.selected {
        border-color: var(--primary);
        background: rgba(255, 107, 0, 0.08);
      }

      .form-group {
        margin-bottom: 16px;
      }

      .form-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: #D4D4D4;
        margin-bottom: 6px;
      }

      .form-input, .form-select, .form-textarea {
        width: 100%;
        background: #111111;
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-sm);
        padding: 12px 14px;
        font-family: var(--font-body);
        font-size: 0.92rem;
        color: #FFFFFF;
        outline: none;
      }

      .form-input:focus, .form-select:focus, .form-textarea:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(255, 107, 0, 0.2);
      }

      .form-row-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }

      /* ===================================================================
         PAINÉIS DE DASHBOARD & CHAT
         =================================================================== */
      .dashboard-view {
        padding: 110px 0 60px;
      }

      .fretes-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 20px;
        margin-top: 24px;
      }

      .frete-card {
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: 22px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .chat-wrapper {
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        height: 75vh;
        min-height: 500px;
        display: grid;
        grid-template-columns: 320px 1fr;
        overflow: hidden;
      }

      .chat-sidebar {
        background: #121212;
        border-right: 1px solid var(--border-subtle);
        overflow-y: auto;
      }

      .conversation-item {
        padding: 14px 16px;
        border-bottom: 1px solid #1A1A1A;
        cursor: pointer;
      }
      .conversation-item:hover, .conversation-item.active {
        background: #1E1E1E;
      }

      .chat-main {
        display: flex;
        flex-direction: column;
        background: #0E0E0E;
      }

      .chat-messages-area {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .chat-msg-row {
        display: flex;
      }
      .chat-msg-row.sent { justify-content: flex-end; }
      .chat-msg-row.received { justify-content: flex-start; }

      .chat-bubble {
        max-width: 70%;
        padding: 10px 16px;
        border-radius: 16px;
        font-size: 0.92rem;
      }
      .chat-bubble.sent { background: var(--primary); color: #FFF; border-bottom-right-radius: 4px; }
      .chat-bubble.received { background: #242424; color: #EEE; border-bottom-left-radius: 4px; }

      .toast-container {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 3000;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .toast {
        background: #181818;
        border: 1px solid var(--border-subtle);
        color: #FFF;
        padding: 12px 20px;
        border-radius: var(--radius-md);
        font-size: 0.9rem;
